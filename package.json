{
  "name": "stock-radar-a-share",
  "version": "1.0.0",
  "description": "A-share market radar app with full stock universe sync, anomaly signals, watchlist, and dashboard.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "sync": "node scripts/sync-a-shares.js",
    "news": "node scripts/sync-news.js",
    "history": "node scripts/sync-history.js",
    "sectors": "node scripts/sync-sectors.js",
    "check": "node scripts/check-data.js",
    "check:api": "node scripts/check-api.js",
    "test": "node --test tests/",
    "index:pinyin": "node scripts/build-pinyin-index.js",
    "update": "node scripts/sync-a-shares.js && node scripts/check-data.js",
    "enrich": "node scripts/sync-sectors.js && node scripts/sync-history.js && node scripts/sync-news.js"
  },
  "keywords": [
    "a-share",
    "stock",
    "dashboard",
    "market-radar"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
